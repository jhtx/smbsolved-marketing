# One voice, forever. Consistency across the channel beats any single read.
# Chosen 2026-08-23: "Jimmy Voice" (the founder's ElevenLabs clone).
# Backup: Eddie - Natural and Helpful (permanent ElevenLabs voice,
# l7kNoIfnJKPg7779LI2t). Switching voices is a logged decision, not a tweak.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_ID_BACKUP=
# eleven_turbo_v2_5 is deprecated (2026). multilingual_v2 is the most stable
# model and the default for /with-timestamps. Do NOT use flash_v2_5: it does
# not normalise numbers by default, and this channel narrates account codes.
ELEVENLABS_MODEL=eleven_multilingual_v2
# Fixed seed for best-effort determinism across regenerations.
ELEVENLABS_SEED=4242

# Writer + reviewer (pipeline/llm.ts). Opus 5 by default.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Delivery (pipeline/deliver.ts). Bot needs chat:write, files:write, reactions:read.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=C0BPQRPQMK5
# OneDrive-synced folder; the sync client uploads it. Default is the SMB Solved
# Marketing folder on this machine.
ARCHIVE_DIR=D:\OneDrive - SMB Solved\SMB Solved\Marketing\Reels

# Dead-man switch (healthchecks.io or similar). run.ts pings it after every
# run, /fail on failure. Missing pings = the box is asleep or logged out.
HEALTHCHECK_URL=

# Website publishing (templates + templates page on smbsolved.com).
# NOT required on this machine: the pipeline publishes with plain git using
# the cached Git Credential Manager credentials. Set a token only if that
# ever stops working or the pipeline moves to another box: fine-grained PAT,
# ONLY the my-website repo, Contents: Read and write.
GITHUB_TOKEN=

# Instagram API with Instagram Login (permalinks for newsletter links now;
# auto-posting later if we choose to). Steps in the strategy doc / recap:
# professional IG account -> developers.facebook.com app -> Instagram product
# -> API setup with Instagram login -> generate long-lived token (60 days,
# refreshable via GET /refresh_access_token).
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# Kit (newsletter). app.kit.com -> Settings -> Developer -> V4 Keys.
# Used by pipeline/kit-setup.ts and, later, the newsletter draft generator.
KIT_API_KEY=

# Optional: richer topic mining from r/Accounting, r/Bookkeeping, r/QuickBooks.
# Free: reddit.com/prefs/apps -> create app -> type "script" -> the ID under
# the app name is the client id, "secret" is the secret. Read-only public
# data, well under the free rate limit. Leave blank and the miner uses
# Stack Exchange only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Auto-posting on the ✅ reaction (pipeline/poll.ts). Every platform is
# optional: without its keys the poller records "skipped, post by hand" and
# says so in the Slack thread. Set one up with:  npm run authorize -- <name>
# ---------------------------------------------------------------------------

# Which platforms a ✅ may post to. Unset means every platform that has working
# credentials. A list restricts it, and it is an ALLOW-list on purpose: adding
# credentials for a platform should never be enough, on its own, to start
# publishing there. Owner's call 2026-08-25: LinkedIn stays manual for now.
AUTOPOST=youtube,instagram

# Public URL for the MP4, which Instagram needs because it fetches the video
# rather than accepting an upload. The file is attached to a GitHub release on
# the public marketing repo (assets live outside git history, so nothing
# bloats). Fine-grained PAT, ONLY jhtx/smbsolved-marketing, Contents: Read and
# write. This is a different token from the website one above.
# GITHUB_TOKEN is shared with the site publisher; set it once.
REELS_ASSET_REPO=jhtx/smbsolved-marketing

# YouTube Shorts. console.cloud.google.com -> new project -> enable "YouTube
# Data API v3" AND "YouTube Analytics API" -> Credentials -> OAuth client ID ->
# Web application -> redirect URI http://localhost:8723/callback. Then:
#   npm run authorize -- youtube
# One consent covers uploading and the nightly analytics pull.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
# Which channel uploads go to. A Google account can manage several (a personal
# one plus Brand Accounts), and the consent screen picks one, so authorising
# with the wrong account silently publishes to the wrong channel. Set this and
# the upload refuses to run anywhere else. npm run doctor prints the id.
YOUTUBE_CHANNEL_ID=

# Instagram publishing reuses INSTAGRAM_ACCESS_TOKEN above, but the token has
# to carry the instagram_business_content_publish scope as well as the basic
# one. Regenerate it in the Meta app with that permission ticked; the refresh
# loop then keeps it alive as before.

# Facebook Reels on the SMB Solved Page. developers.facebook.com -> the same
# app Instagram uses -> add the Facebook Login product -> Settings -> Valid
# OAuth Redirect URIs must include http://localhost:8723/callback. Then:
#   npm run authorize -- facebook
# On the consent screen you MUST tick the SMB Solved Page. Granting the three
# permissions is not enough on its own: without a Page, /me/accounts comes back
# empty and the token cannot post anywhere.
#
# FACEBOOK_PAGE_TOKEN must be a PAGE token, not a user token. They look
# identical in this file, carry the same permissions, and only one of them can
# post. `npm run doctor` tells them apart. A Page token derived from a
# long-lived user token never expires, so this is a one-time setup.
# Already hold a user token? Trade it without the app secret:
#   npm run authorize -- facebook --from-user-token
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
# Optional; defaults to v25.0.
FACEBOOK_API_VERSION=

# LinkedIn, posting to the founder's personal profile.
# developer.linkedin.com -> app -> Products: "Share on LinkedIn" and "Sign In
# with LinkedIn using OpenID Connect" -> Auth -> redirect
# http://localhost:8723/callback. Then:  npm run authorize -- linkedin
# The access token lasts 60 days and is the credential (refresh tokens are
# only issued to approved apps), so this needs redoing roughly every 8 weeks.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
# Optional; looked up from the token when blank.
LINKEDIN_MEMBER_URN=
# LinkedIn requires a dated version header. Bump when they retire one.
LINKEDIN_VERSION=202608

# TikTok. developers.tiktok.com -> app -> Login Kit + Content Posting API.
# TikTok will not accept a localhost redirect, so register an https URL you
# control and run:  npm run authorize -- tiktok --paste
# Until the app passes content-posting audit this can only push a DRAFT to the
# app inbox, which is what the pipeline reports. It never claims "posted".
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
